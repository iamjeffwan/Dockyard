{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dockyard.local/schemas/context-memory.schema.json",
  "title": "Dockyard scoped context memory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "project", "entries"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "project": { "type": "string", "minLength": 1 },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" },
      "uniqueItems": true
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "category", "status", "statement", "scope", "source"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "category": { "enum": ["preference", "fact", "temporary-feedback", "review-resolution", "hard-constraint"] },
        "status": { "enum": ["proposed", "active", "superseded", "archived"] },
        "statement": { "type": "string", "minLength": 1 },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["surfaces", "components", "conditions"],
          "properties": {
            "surfaces": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
            "components": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
            "conditions": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true }
          }
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reviewId", "itemId", "original"],
          "properties": {
            "reviewId": { "type": "string" },
            "itemId": { "type": "string" },
            "original": { "type": "string", "minLength": 1 },
            "evidence": { "type": "string" }
          }
        },
        "rationale": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
